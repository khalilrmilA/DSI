# Copy to .env (or set these in the environment) before `npm start`.
# The kiosk browser NEVER sees these values — they stay in the Node process.

PORT=8080
HOST=0.0.0.0

# MongoDB (storage for leads + event logs)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=forum_dsi

# Leak data source: "elastic" (default) or "scanbe4". Also settable in the dashboard.
LEAK_SOURCE=elastic

# Elasticsearch holding the leaks_data index (server-side only)
ES_URL=http://10.9.21.32:9200
ES_INDEX=leaks_data
# ES_USER=
# ES_PASS=
ES_TIMEOUT_MS=20000

# ScanBe4 API (optional defaults — the token is best set from the dashboard, stored in DB)
# SB4_LEAKS_URL=https://scanbe4.com/api/v1/leaks
# SB4_SCAN_URL=https://scanbe4.com/api/v1/scans
# SB4_TOKEN=sb4_lk_...

# Abuse protection: max /api/leak-check calls per IP per window
RATE_MAX=20
RATE_WINDOW_MS=60000

# Super-admin login (http://localhost:8080/superadmin). CHANGE THE PASSWORD (or change it from the dashboard).
ADMIN_USER=superadmin
ADMIN_PASS=Admin@2026
