# Copy to ".env" next to docker-compose.yml, then edit. docker compose reads it automatically.

# MongoDB credentials (the app connects with these; data persists in the mongo-data volume)
MONGO_USER=admin
MONGO_PASS=change-me-strong-password
MONGO_DB=forum_dsi

# Port exposed on the server for the kiosk + super-admin
APP_PORT=8080

# Leak data source: "elastic" or "scanbe4" (also switchable live from the dashboard)
LEAK_SOURCE=elastic

# Elasticsearch holding the leaks (reachable from the server). Stays server-side only.
ES_URL=http://10.9.21.32:9200
ES_INDEX=leaks_data
# ES_USER=
# ES_PASS=

# ScanBe4 API (the token is best entered in the dashboard; it is stored in MongoDB)
# SB4_LEAKS_URL=https://scanbe4.com/api/v1/leaks
# SB4_SCAN_URL=https://scanbe4.com/api/v1/scans
# SB4_TOKEN=sb4_lk_...

# Super-admin login (http://<server>:8080/superadmin). Can also be changed from the dashboard.
ADMIN_USER=superadmin
ADMIN_PASS=Admin@2026
